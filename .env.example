# oopsie server-side configuration. keep the populated file untracked.
# point at a private file outside this repository, or set sponsor keys as exported variables.
OOPSIE_CREDENTIAL_FILE=/absolute/path/to/private/creds

# public urls used by the gateway and post-deployment probe.
OOPSIE_APP_URL=https://app.oopsie.website
OOPSIE_API_URL=https://api.oopsie.website

# mongodb community should be bound to loopback; worker uses the oopsie database.
MONGODB_URI=mongodb://127.0.0.1:27017

# sponsor keys may be supplied here instead of the private credential file.
AKASHML_API_KEY=
SENSO_API_KEY=
CLICKHOUSE_CLOUD_API_KEY=
CLICKHOUSE_CLOUD_API_SECRET=
GUILD_API_KEY=
ELEVENLABS_API_KEY=

# primary runtime reasoning. the model is pinned in worker/intelligence.py;
# availability and credits must be checked in each deployment.
OPENAI_API_KEY=
# worker/intelligence.py pins the approved model to gpt-6-sol.

# static scans currently use local semgrep community edition without a token.
